// TUNIO 작업 흐름 v3 — 2026-09-30, main c6ec065 기준
// v2(2026-09-21) 이후 바뀐 것: 페그 등록이 별도 버튼(조율 1회마다), 발현 준비(PreparePluck) 분리,
// 피크 확인·재집기·보충 대기, 취소·일시정지 즉시 정지, 검증은 1차 성공 줄만, 화음 대신 ReturnHome.
//
// 렌더 (graphviz 가 있을 때):  dot -Tsvg docs/TUNIO_작업흐름_v3.dot -o docs/TUNIO_작업흐름_v3.svg
//   PNG: rsvg-convert -w 1800 docs/TUNIO_작업흐름_v3.svg -o docs/TUNIO_작업흐름_v3.png
// graphviz 가 없는 맥에서는 npm 의 @viz-js/viz 로 SVG 를, headless Chrome 으로 PNG 를 만들었다 (2026-09-30).
digraph TUNIO_FLOW_V3 {
  graph [rankdir=TB, fontname="Noto Sans CJK KR", labelloc=t, fontsize=28, newrank=true,
         label=<<B>TUNIO 작업 흐름 v3</B><BR/><FONT POINT-SIZE="13" COLOR="#5A635E">2026-09-30 · 페그 재등록 버튼 → 시작 · 발현 준비 분리 · 피크 확인/보충 대기 · 취소/일시정지 즉시 정지</FONT><BR/> >,
         bgcolor="#FBFCFA", nodesep=0.30, ranksep=0.38, compound=true];
  node  [shape=box, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=13,
         margin="0.26,0.14", penwidth=1.4, width=4.4];
  edge  [fontname="Noto Sans CJK KR", fontsize=10.5, color="#79837D", penwidth=1.2,
         arrowsize=0.75, fontcolor="#47524D"];

  prep [label=<<B>사람 준비</B><BR/><FONT POINT-SIZE="10.5">기타 거치 · 세로로 선 페그 손잡이 눕히기 · 피크를 거치대에 · USB 마이크</FONT>>, fillcolor="#EFF0EE", color="#9AA5AE"];

  subgraph cluster_p0 {
    label=<<B>Phase 0 · 페그 재등록</B><BR/><FONT POINT-SIZE="11">관제 웹 「페그 재등록」 버튼 · 조율 1회마다 필요</FONT><BR/> >;
    fontsize=15; fontcolor="#6B5A9E"; color="#8C7AB8"; style=rounded; penwidth=1.6; bgcolor="#F4F2FA";
    p0h [label=<<B>ReturnHome → 대기 자세</B><BR/><FONT POINT-SIZE="10.5">홈이 아닌 자리에서 페그로 바로 가지 않는다 (9/29)</FONT>>, fillcolor="#E5E0F4", color="#8C7AB8"];
    p0a [label=<<B>줄마다 페그를 꽉 물어 각도 등록</B><BR/><FONT POINT-SIZE="10.5">RegisterPeg(force=true) 6 → 5 → 2 → 1 · close 15mm · 폭으로 물림/사점/빈손 판정</FONT>>, fillcolor="#E5E0F4", color="#8C7AB8"];
    p0b [label=<<B>복귀 → 대기(IDLE) · 시작 허가 1회 발급</B><BR/><FONT POINT-SIZE="10.5">측정·조율·DB 저장 없음 · 실패/취소면 허가 없음</FONT>>, fillcolor="#E5E0F4", color="#8C7AB8"];
    p0h -> p0a -> p0b;
  }

  start [label=<<B>「시작」 버튼</B><BR/><FONT POINT-SIZE="10.5">허가를 소비한다 · 완료·오류·취소 뒤 다음 조율은 재등록부터</FONT>>, fillcolor="#EFF0EE", color="#9AA5AE"];

  subgraph cluster_p1 {
    label=<<B>Phase 1 · 조율 루프</B><BR/><FONT POINT-SIZE="11">줄당 페그 조절 최대 5회 / 재측정 최대 3회 (임시값)</FONT><BR/> >;
    fontsize=15; fontcolor="#7A6A2E"; color="#B8A050"; style=rounded; penwidth=1.6; bgcolor="#FAF8EE";
    sel   [label=<<B>대상 줄 선택</B><BR/><FONT POINT-SIZE="10.5">6 → 5 → 2 → 1 · 한 줄을 끝까지 맞추고 다음 줄</FONT>>, fillcolor="#E8E2F5", color="#8C7AB8"];
    prepk [label=<<B>발현 준비 (PreparePluck)</B><BR/><FONT POINT-SIZE="10.5">피크 집기 → 줄 위 접근점 · 일회용 preparation_id 발급<BR/>verify_pick:=true 면 그리퍼 폭으로 피크 확인 (13.3mm↑ = 있음)</FONT>>, fillcolor="#F0F1EF", color="#9AA5AE"];
    pick  [label=<<B>피크가 없다?</B><BR/><FONT POINT-SIZE="10.5">verify_pick 켰을 때 · 재집기 2회 → 그래도 없으면 홈 복귀</FONT>>, shape=diamond, width=4.0, height=1.2, fillcolor="#FAE7C6", color="#C9873A", margin="0.05,0.05"];
    refill[label=<<B>보충 대기 (PAUSED)</B><BR/><FONT POINT-SIZE="10.5">웹에 「로봇 알림」 띠 · 사람이 피크를 꽂고 「재개」 → 같은 줄 처음부터</FONT>>, fillcolor="#FCEBD0", color="#C9873A"];
    mic   [label=<<B>마이크 준비 (MeasurePitch → ready)</B><BR/><FONT POINT-SIZE="10.5">ready 를 받은 뒤에만 발현 · 목표 ±2반음만 탐색</FONT>>, fillcolor="#D2EDE0", color="#2E9070"];
    pluck [label=<<B>발현 (PlayString) → 측정</B><BR/><FONT POINT-SIZE="10.5">튕긴 뒤 즉시 5mm 후퇴 · 마이크가 onset 을 스스로 검출<BR/>응답 목표 2.2초 · 타임아웃 10초 · onset 제한 10초</FONT>>, fillcolor="#D2EDE0", color="#2E9070"];
    valid [label=<<B>유효한 측정인가?</B><BR/><FONT POINT-SIZE="10.5">FFT 돌출 ≥20dB · 겹친 창 일치 ≤12센트</FONT>>, shape=diamond, width=4.2, height=1.25, fillcolor="#FAE7C6", color="#C9873A", margin="0.05,0.05"];
    cent  [label=<<B>허용 센트 이내인가?</B><BR/><FONT POINT-SIZE="10.5">1200 × log2(측정 ÷ 목표) · 10센트 (임시값)</FONT>>, shape=diamond, width=4.2, height=1.25, fillcolor="#FAE7C6", color="#C9873A", margin="0.05,0.05"];
    ok    [label=<<B>그 줄 성공 기록</B>>, fillcolor="#D2EDE0", color="#2E9070"];
    more  [label=<<B>남은 줄이 있는가?</B>>, shape=diamond, width=3.8, height=1.1, fillcolor="#FAE7C6", color="#C9873A", margin="0.05,0.05"];
    retry [label=<<B>재측정</B><BR/><FONT POINT-SIZE="10.5">페그는 안 돌린다 · 최대 3회 · 소진 시 그 줄 실패</FONT>>, fillcolor="#FADEDE", color="#C25A5A"];
    peg   [label=<<B>피크 반환 → 페그 조절 (AdjustPeg)</B><BR/><FONT POINT-SIZE="10.5">각도 = |오차| ÷ 센트/도 (줄별 실측) · 최대 5회<BR/>목표보다 높으면 목표 아래로 풀었다 조여 올린다<BR/>(백래시 마무리 — 서버가 결정)</FONT>>, fillcolor="#FADEDE", color="#C25A5A"];

    sel -> prepk -> pick;
    pick -> mic    [label=" 있음"];
    pick -> refill [label=" 없음 · 재집기 소진"];
    refill -> prepk [label=" 재개", constraint=false];
    mic -> pluck -> valid;
    valid -> cent  [label=" 예"];
    valid -> retry [label=" 아니오"];
    retry -> prepk [constraint=false];
    cent -> ok  [label=" 예"];
    cent -> peg [label=" 아니오"];
    peg -> prepk [label=" 재측정", constraint=false];
    ok -> more;
    more -> sel [label=" 예", constraint=false];
  }

  subgraph cluster_p2 {
    label=<<B>Phase 2 · 검증 · 복귀 · 저장</B><BR/> >;
    fontsize=15; fontcolor="#1C5686"; color="#3E7FB8"; style=rounded; penwidth=1.6; bgcolor="#EEF5FC";
    ver  [label=<<B>최종 검증 패스</B><BR/><FONT POINT-SIZE="10.5">1차 성공 줄만 다시 측정 (조절 없음)<BR/>틀어졌으면 실패로 재기록 · 1차 실패 줄은 사유 보존<BR/>한 줄을 조이면 넥이 당겨 다른 줄이 틀어진다</FONT>>, fillcolor="#D2EDE0", color="#2E9070"];
    home [label=<<B>ReturnHome</B><BR/><FONT POINT-SIZE="10.5">피크 반환 → 대기 자세 · 화음(StrumAll)은 호출하지 않는다</FONT>>, fillcolor="#D9E9F8", color="#3E7FB8"];
    save [label=<<B>결과 저장 (SQLite)</B><BR/><FONT POINT-SIZE="10.5">4줄 완주면 PARTIAL · FAILED 도 저장 · 설정 스냅샷 같이<BR/>중간에 끊긴 작업은 저장하지 않는다 · DB ~/.tunio/tunio.db</FONT>>, fillcolor="#D9E9F8", color="#3E7FB8"];
    ver -> home -> save;
  }

  subgraph cluster_ctl {
    label=<<B>언제든 · 관제 웹 버튼</B><BR/> >;
    fontsize=15; fontcolor="#8A3B2E"; color="#C25A5A"; style=rounded; penwidth=1.6; bgcolor="#FBEFED";
    pause [label=<<B>일시정지</B><BR/><FONT POINT-SIZE="10.5">로봇 즉시 정지 (MoveStop → IDLE 확인) · 접촉만 풀고 그 자리 대기<BR/><B>재개</B> → 그 줄을 처음부터<BR/>(페그 조절·등록 중이었으면 그 줄만 강제 재등록)</FONT>>, fillcolor="#FBDCD8", color="#C25A5A"];
    cancel[label=<<B>취소</B><BR/><FONT POINT-SIZE="10.5">로봇 즉시 정지 → 서버가 ReturnHome → CANCELED · 저장 안 함<BR/>노드 재시작 없이 다음 재등록·시작 가능</FONT>>, fillcolor="#FBDCD8", color="#C25A5A"];
    pause -> cancel [style=invis];
  }

  prep -> p0h;
  p0b -> start [label=" 등록·복귀 성공"];
  start -> sel;
  more -> ver [label=" 아니오"];
  save -> pause [style=invis];
}
