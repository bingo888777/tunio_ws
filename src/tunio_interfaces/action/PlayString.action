# 지정한 줄을 피크로 한 번 튕긴다.
# task_manager -> robot_controller
# 발현 직후 5mm 이상 후퇴(버징 방지)는 로봇 내부에서 처리한다.

# --- Goal ---
uint8 string_number        # 실제 줄 번호 (6, 5, 2, 1). 교시된 좌표를 로봇이 조회한다
string preparation_id     # PreparePluck 성공 식별자. 빈 문자열은 기존 단독 도구의 준비+발현 경로
---
# --- Result ---
bool success               # 동작 수행 성공 여부
string message             # 실패 시 사람이 읽을 사유. 성공 시 빈 문자열
---
# --- Feedback ---
# 사용하지 않음
# 향후 추가 예정: 힘 미분으로 발현 순간 감지
