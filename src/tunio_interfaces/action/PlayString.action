# 지정한 줄을 피크로 한 번 튕긴다.
# task_manager -> robot_controller
# 발현 직후 5mm 이상 후퇴(버징 방지)는 로봇 내부에서 처리한다.

# --- Goal ---
uint8 string_number        # 실제 줄 번호 (6, 5, 2, 1). 교시된 좌표를 로봇이 조회한다
bool resumed              # 일시정지 후 첫 발현 요청. 피크 판정은 로봇 내부에서 수행

string preparation_id     # PreparePluck 성공 식별자. 빈 문자열은 기존 단독 도구의 준비+발현 경로
---
# --- Result ---
bool success               # 동작 수행 성공 여부
string message             # 실패 사유 또는 성공 시 비치명적 경고. 경고 없으면 빈 문자열
bool pick_refill_required  # 재집기 소진 후 홈 복귀 완료. 보충·재개 대기 필요
---
# --- Feedback ---
string warning             # 재집기 소진·홈 복귀·보충 안내. 발현 시점 신호가 아님
